{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "a-b-technologies",
  "pages_build_output_dir": ".",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "AUDIT_DB",
      "database_name": "ab-audit-express",
