    }
  ],
  "vars": {
    "EMAIL_PROVIDER": "brevo",
    "ADMIN_EMAIL": "aetbconseil@gmail.com",
    "EMAIL_FROM": "aetbconseil@gmail.com",
    "EMAIL_FROM_NAME": "A&B Technologies",
    "ADMIN_URL": "https://a-b-technologies.pages.dev/audits-express-admin.html"
  }
}
